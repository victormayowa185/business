<file path="src/styles/contact.css">
/* ===========================================================
   CONTACT PAGE — Hero + Intro + Form
   =========================================================== */

/* ─── Hero (same pattern as About/Investments/Videos/News) ─── */
.contact-hero {
  position: relative;
  width: 100%;
  height: 60vh;
  min-height: 120px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  font-family: "Sora", "Segoe UI", sans-serif;
  color: #ffffff;
  isolation: isolate;
}

.contact-hero__bg {
  position: absolute;
  inset: 0;
  background-image: url("/contact.webp");
  background-size: cover;
  background-position: center;
  z-index: 0;
  /* Subtle continuous "breathing" zoom — gentle in/out, not a hard pulse. */
  transform-origin: center center;
  animation: contact-hero-breathe 12s ease-in-out infinite;
  will-change: transform;
}

@keyframes contact-hero-breathe {

  0%,
  100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.05);
  }
}

.contact-hero__scrim {
  position: absolute;
  inset: 0;
  background: rgba(10, 10, 12, 0.5);
  z-index: 1;
}

.contact-hero__wordmark {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32px 60px 32px;
  box-sizing: border-box;
}

.contact-svg {
  width: 100%;
  height: auto;
  max-height: 20vh;
  display: block;
}

.contact-svg__letter {
  fill: none;
  stroke: #ffffff;
  stroke-width: 1.5;
  vector-effect: non-scaling-stroke;
}

/* ─── Intro (same pattern as About biography / Investments bio) ─── */
.contact-intro {
  width: 100%;
  background: #ffffff;
  padding: 80px 8% 40px;
}

.contact-intro__container {
  max-width: 900px;
  margin: 0 auto;
}

.contact-intro__content {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
}

.contact-intro__bullet {
  width: 48px;
  height: 48px;
  object-fit: contain;
  flex-shrink: 0;
  margin-top: 0.2rem;

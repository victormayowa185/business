  margin: 0 0 1rem 0;
  text-align: left;
}


.contact-intro__link:hover {
  color: #000032;
  border-bottom-color: rgba(0, 0, 50, 0.4);
}

/* ─── Contact Form ─── */
.contact-form-section {
  width: 100%;
  background: #ffffff;
  padding: 20px 8% 120px;
}

.contact-form-container {
  max-width: 640px;
  margin: 0 auto;
}

.contact-form-card {
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding: 36px;
  border-radius: 14px;
  border: 1px solid rgba(0, 0, 0, 0.453);
  background: #ffffff;
  box-sizing: border-box;
}

.contact-form__field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.contact-form__label {
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #000032;
}

.contact-form__required {
  color: #cc0033;
}

.contact-form__input,
.contact-form__textarea {
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 0.95rem;
  color: #1a1a1a;

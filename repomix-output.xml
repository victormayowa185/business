/* ===========================================================
   ABOUT PAGE — Hero + Biography
   =========================================================== */

/* ─── Hero ─── */
.about-hero {
    position: relative;
    width: 100%;
    height: 60vh;
    /* was 100vh */
    min-height: 120px;
    /* was 640px */
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    font-family: "Sora", "Segoe UI", sans-serif;
    color: #ffffff;
    isolation: isolate;
}

.about-hero__bg {
    position: absolute;
    inset: 0;
    background-image: url("/about.webp");
    background-size: cover;
    background-position: center 22%;
    z-index: 0;
    /* Subtle continuous "breathing" zoom — gentle in/out, not a hard pulse. */
    transform-origin: center center;
    animation: about-hero-breathe 12s ease-in-out infinite;
    will-change: transform;
}

@keyframes about-hero-breathe {
    0%,
    100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.05);
    }
}

.about-hero__scrim {
    position: absolute;

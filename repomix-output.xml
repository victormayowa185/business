}

.mission-block__text {
  margin: 0;
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 1.1rem;
  line-height: 1.7;
  font-weight: 400;
  color: #000000;
  text-align: left;
}

.mission-block__link {

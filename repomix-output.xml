/* ===========================================================
   VIDEOS PAGE — Hero + Masonry Grid
   =========================================================== */

/* ─── Hero ─── */
.videos-hero {
  position: relative;
  width: 100%;
  height: 60vh;
  min-height: 120px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  font-family: "Sora", "Segoe UI", sans-serif;
  color: #ffffff;
  isolation: isolate;
}

.videos-hero__bg {
  position: absolute;
  inset: 0;
  background-image: url("/videos.webp"); /* change to your video hero image */
  background-size: cover;
  background-position: center 25%;
  z-index: 0;
  /* Subtle continuous "breathing" zoom — gentle in/out, not a hard pulse. */
  transform-origin: center center;
  animation: videos-hero-breathe 12s ease-in-out infinite;
  will-change: transform;
}

@keyframes videos-hero-breathe {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.videos-hero__scrim {
  position: absolute;
  inset: 0;
  background: rgba(10, 10, 12, 0.5);
  z-index: 1;
}

.videos-hero__wordmark {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32px 60px 32px;
  box-sizing: border-box;
}

.videos-svg {
  width: 100%;
  height: auto;
  max-height: 20vh;
  display: block;
}

.videos-svg__letter {
  fill: none;
  stroke: #ffffff;
  stroke-width: 1.5;
  vector-effect: non-scaling-stroke;
}

/* ─── Video Grid Section ─── */
.videos-grid-section {
  width: 100%;
  background: #ffffff;
  padding: 60px 8% 120px;
}

.videos-grid-container {
  max-width: 1200px;
  margin: 0 auto;
}

/* True masonry via CSS columns */
.video-masonry {
  column-count: 3;
  column-gap: 24px;
  max-width: 1200px;
  margin: 0 auto;
}

/* ─── Video Card ─── */
.video-card {
  break-inside: avoid;
  display: block;
  margin-bottom: 24px;
  border-radius: 2px;
  padding: 0;
  text-decoration: none;
  color: inherit;
  box-sizing: border-box;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  background: #ffffff;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.video-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 30px rgba(0, 0, 50, 0.1);
}

/* Card height variants for masonry rhythm */
.video-card--sm {
  padding-bottom: 12px;
}
.video-card--md {
  padding-bottom: 16px;
}
.video-card--lg {
  padding-bottom: 24px;
}

/* ─── Thumbnail Container ─── */
.video-card__image {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #f0f0f0;
}

.video-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.video-card:hover .video-card__image img {
  transform: scale(1.02);
}

/* ─── Date badge — bottom right on image ─── */
.video-card__date {
  position: absolute;
  bottom: 10px;
  right: 12px;
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  color: #ffffff;
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 4px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  pointer-events: none;
}

/* ─── Card Body ─── */
.video-card__body {
  padding: 16px 18px 10px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.video-card__title {
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: #000032;
  margin: 0;
  line-height: 1.3;
}

.video-card__excerpt {
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 0.9rem;
  line-height: 1.6;
  color: #333333;
  margin: 4px 0 0 0;
  flex: 1;
}

.video-card__link {
  display: inline-block;
  margin-top: 8px;
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  color: #7C3EFF;
  transition: color 0.2s ease;
  align-self: flex-start;
}

.video-card__link::after {
  content: " →";
  transition: transform 0.2s ease;
}

.video-card:hover .video-card__link::after {
  transform: translateX(4px);
}

/* ─── Responsive (≤ 900px) ─── */
@media (max-width: 900px) {
  .video-masonry {
    column-count: 2;
    column-gap: 20px;
  }
}

/* ─── Responsive (≤ 768px) ─── */
@media (max-width: 768px) {
  .videos-hero {
    height: 35vh !important;
    min-height: 20% !important;
  }

  .videos-hero__wordmark {
    padding: 0 16px 40px 16px;
  }

  .videos-svg {
    max-height: 30vh;
  }

  .videos-grid-section {
    padding: 40px 6% 80px;
  }

  .video-masonry {
    column-count: 1;
    column-gap: 16px;
  }

  .video-card {
    margin-bottom: 16px;
  }

  .video-card__body {
    padding: 14px 16px 8px;
  }

  .video-card__title {
    font-size: 0.95rem;
  }

  .video-card__excerpt {
    font-size: 0.85rem;
  }

  .video-card__date {
    font-size: 0.65rem;
    bottom: 8px;
    right: 10px;
    padding: 3px 8px;
  }
}

/* ─── Small phones (≤ 480px) ─── */
@media (max-width: 480px) {
  .videos-hero {
    height: 38vh;
    min-height: 280px;
  }

  .videos-svg {
    max-height: 22vh;
  }

  .video-card__title {
    font-size: 0.9rem;
  }

  .video-card__excerpt {
    font-size: 0.8rem;
  }
}

/* ─── Reduce Motion ─── */
@media (prefers-reduced-motion: reduce) {
  .videos-svg__letter {
    stroke-dasharray: none !important;
  }

  .video-card {
    transition: none;
  }

  .video-card:hover .video-card__image img {
    transform: none;
  }

  .videos-hero__bg {
    animation: none !important;
  }
}

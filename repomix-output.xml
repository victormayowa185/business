<file path="src/styles/navbar.css">
/* ─── Outer Navbar ─── */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 0.9rem 1rem;
  z-index: 1050;
  pointer-events: none;
}

/* ─── The Pill (main container) – using GRID ─── */
.navbar-inner {
  pointer-events: auto;
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: none;
  border-radius: 0;
  padding: 0.6rem 0;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: start;
  width: 100%;
  max-width: 1400px;
  transition: all 0.3s ease;
  box-shadow: none;
}

/* ─── LEFT: Logo – aligned to the left edge ─── */
.navbar-brand {
  display: flex;
  align-items: flex-start;
  justify-self: start;
  flex-shrink: 0;
  margin-top: -1.1rem;
}

/* ─── Logo wrapper – default: visible ─── */
.brand-logo-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.2rem 0.6rem;
  border-radius: 9999px;
  transition: opacity 0.4s ease, transform 0.4s ease;
  margin-left: -0.4rem;
  opacity: 1;
  transform: scale(1);
}

/* ─── Logo image ─── */
.brand-logo-img {
  height: 100px;
  width: auto;
  display: block;
}

/* ─── No desktop hiding – logo stays visible, it's the TSX that swaps the src ─── */

/* ─── CENTER: TRUE GLASSMORPHISM – perfectly centered ─── */
.nav-center-glass {
  display: flex;
  align-items: center;
  gap: 2rem;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(36px) saturate(180%);
  -webkit-backdrop-filter: blur(36px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.40);
  border-radius: 9999px;
  padding: 0.3rem 1.8rem;
  justify-self: center;
  box-shadow:
    0 4px 20px rgba(0, 0, 0, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.6);
}

/* ─── Default glass links (on hero) ─── */
.glass-link {
  color: white;
  text-decoration: none;
  font-weight: 500;
  font-size: 0.75rem;
  padding: 0.4rem 0;
  transition: all 0.2s;
  white-space: nowrap;
}

.glass-link:hover {
  color: white;
  transform: translateY(-1px);
}

/* ─── Active link: white + underline on hero ─── */
.glass-link.active {
  color: #ffffff;
  font-weight: 600;
  border-bottom: 2px solid rgba(255, 255, 255, 0.5);
}

/* ─── RIGHT: Live Clock (WAT) ─── */
.nav-clock {
  flex-shrink: 0;
  justify-self: end;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.1rem;
  line-height: 1.2;
  transition: color 0.3s ease;
  margin-right: 2.5rem;
  margin-top: 0.5rem;
}

.nav-clock__label {
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 0.55rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  transition: color 0.3s ease;
}

.nav-clock__time {
  font-family: "Sora", "Segoe UI", sans-serif;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #ffffff;
  transition: color 0.3s ease;
}

/* ─── Scroll state: text turns dark when past hero ─── */
.navbar-scrolled .glass-link {
  color: #000000;
}

.navbar-scrolled .glass-link:hover {
  color: #000000;
}

/* ─── Scrolled active: dark + dark underline ─── */
.navbar-scrolled .glass-link.active {
  color: #000;
  border-bottom-color: rgba(0, 0, 0, 0.5);
}

.navbar-scrolled .news-link {
  color: #000000;
}

.navbar-scrolled .news-link:hover {
  color: #000000;
  background: rgba(0, 0, 0, 0.05);
  border-color: rgba(0, 0, 0, 0.2);
}

/* ─── Scrolled state: clock text turns dark ─── */
.navbar-scrolled .nav-clock__label {
  color: rgba(0, 0, 0, 0.4);
}

.navbar-scrolled .nav-clock__time {
  color: #000000;
}

/* ─── RIGHT: News & Articles – aligned to the right edge ─── */
.nav-right-news {
  flex-shrink: 0;
  justify-self: end;
}

.news-link {
  color: white;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  padding: 0.4rem 1rem;
  border-radius: 9999px;
  border: 1px solid rgba(0, 0, 0, 0.10);
  transition: all 0.3s;
  white-space: nowrap;
}

.news-link:hover {
  background: rgba(0, 0, 0, 0.04);
  border-color: rgba(0, 0, 0, 0.2);
  color: white;
}

.navbar-scrolled .hamburger {
  color: #000000;
}

/* ─── Hamburger (hidden on desktop) ─── */
.hamburger {
  display: none;
  background: none;
  border: none;
  font-size: 2rem;
  cursor: pointer;
  color: black;
  padding: 0.2rem;
  line-height: 1;
  transition: transform 0.2s;
  touch-action: manipulation;
}

.hamburger:hover {
  transform: scale(1.1);
}

/* ─── Mobile Drawer (hidden on desktop) ─── */
.nav-links {
  display: none;
}
.navbar-scrolled .nav-center-glass {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(30px) saturate(180%);
  -webkit-backdrop-filter: blur(30px) saturate(180%);
}

/* ─── 📱 Mobile (≤ 900px) ─── */
@media (max-width: 900px) {
  .navbar-scrolled .navbar-inner {
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 9999px;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .navbar {
    padding: 0.5rem 1rem;
  }

  .navbar-inner {
    display: flex;
    width: 95%;
    padding: 0.1rem 1.2rem;
    gap: 0.5rem;
    position: relative;
  }

  .brand-logo-img {
    margin-top: 0.3rem;
    height: 80px;
  }

  .navbar-brand {
    margin-right: auto;
    margin-left: -2.9rem;
  }

  .navbar-scrolled .navbar-brand {
    margin-right: 0;
    margin-left: 0;
    min-width: 0;
    flex: 0 0 auto;
  }

  .nav-center-glass {
    display: none;
  }

  .nav-right-news {
    display: none;
  }

  .hamburger {
    display: block;
    color: white;
    margin-left: auto;
    order: 3;
  }

  /* ─── Mobile: clock centered while logo is still visible ─── */
  .nav-clock {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    align-items: center;
    margin-right: 0;
    background: transparent !important;
    backdrop-filter: none !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  .nav-clock__label {
    font-size: 0.65rem;
  }

  .nav-clock__time {
    font-size: 0.9rem;
  }

  /* ─── Mobile scrolled: logo completely hidden ─── */
  .navbar-scrolled .brand-logo-wrapper {
    display: none;
  }

  /* ─── Mobile scrolled: clock moves to the left ─── */
  .navbar-scrolled .nav-clock {
    position: static;
    left: auto;
    transform: none;
    align-items: flex-start;
  }

  /* ─── Mobile Drawer – solid white background ─── */
  .nav-links {
    display: flex;
    position: fixed;
    top: 0;
    right: -100%;
    width: min(75%, 280px);
    height: 100vh;
    pointer-events: auto;
    background: #ffffff;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-left: 1px solid rgba(0, 0, 0, 0.1);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    transition: right 0.3s ease-in-out;
    z-index: 1060;
    padding: 2rem 1.5rem;
    list-style: none;
    margin: 0;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  }

  .nav-links.open {
    right: 0;
  }

  .nav-links li a {
    color: rgba(0, 0, 0, 0.75);
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 500;
    padding: 0.6rem 1.5rem;
    border-radius: 40px;
    transition: background 0.2s;
  }

  .nav-links li a:hover {
    background: rgba(0, 0, 0, 0.05);
    color: #000;
  }

  .nav-links li a.active {
    background: rgba(0, 0, 0, 0.08);
    color: #000;
  }
}

/* ─── Small phones (≤ 480px) ─── */
@media (max-width: 480px) {
  .nav-clock__time {
    font-size: 0.8rem;
  }

  .nav-clock__label {
    font-size: 0.7rem;
  }
}

/* ─── Overlay ─── */
.menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(2px);
  z-index: 1040;
}
</file>

